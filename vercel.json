{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": "apps/api",
      "framework": "hono",
      "buildCommand": "pnpm build",
      "outputDirectory": "dist/apps/api/src",
      "functions": {
        "dist/apps/api/src/index.mjs": {
          "includeFiles": "dist/packages/contract/openapi.yaml"
        }
      }
    },
    "web": { "root": "apps/web", "framework": "nextjs" }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
