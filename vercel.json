{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": "apps/api",
      "framework": "hono",
      "buildCommand": "pnpm build",
      "outputDirectory": "dist/apps/api/src"
    },
    "web": { "root": "apps/web", "framework": "nextjs" }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ],
  "schedules": {
    "demo-db-liveness": { "schedule": "*/15 * * * *", "path": "/api/health/db", "requestMethod": "GET" },
    "settlement-sweep": { "schedule": "*/15 * * * *", "path": "/api/internal/settlement/sweep", "requestMethod": "POST" }
  }
}
