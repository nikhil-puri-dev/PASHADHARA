# Copy to .env and fill in. Never commit .env. PayPal values are SANDBOX credentials only.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
BUYER_EMAIL=
SELLER_A_EMAIL=
SELLER_B_EMAIL=

# Postgres (Supabase). The app connects as a login role that can SET ROLE pashadhara_app.
DATABASE_URL=
DATABASE_ADMIN_URL=

# Judges and spend guard
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
JUDGE_PROVIDERS=
AI_SPEND_LIMIT_USD=15

# Gateway. API_BASE_URL is the public site origin plus /api.
# LEASE_TOKEN_SECRET and ADMIN_KEY each require at least 32 characters.
LEASE_TOKEN_SECRET=
ADMIN_KEY=
FAULTS_ENABLED=false
API_BASE_URL=

# Optional public sandbox showcase. Leave the lease ID unset for recorded mode.
SHOWCASE_LEASE_ID=
AI_ENABLED=true
